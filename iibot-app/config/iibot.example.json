{
  "dataDir": "./data",
  "publicGroupId": "100000000",
  "maxTurnMinutes": 240,
  "napcat": {
    "eventWebSocketUri": "ws://127.0.0.1:3001/",
    "httpBaseUri": "http://127.0.0.1:3000/",
    "accessTokenEnv": "IIBOT_NAPCAT_ACCESS_TOKEN",
    "accountId": "100000001",
    "privateTempGroupId": "",
    "suppressSelfMessages": true,
    "requestTimeoutSeconds": 10,
    "maxTextLength": 2000
  },
  "players": [
    {
      "playerId": "player-1",
      "qqId": "200000001",
      "displayName": "玩家一"
    },
    {
      "playerId": "player-2",
      "qqId": "200000002",
      "displayName": "玩家二"
    }
  ],
  "directors": [
    {
      "playerId": "director-1",
      "qqId": "300000001",
      "displayName": "推演"
    }
  ],
  "world": {
    "promptVersion": "prompt-v1",
    "factsFile": "./world-facts.example.json"
  },
  "llm": {
    "baseUrl": "https://api.example.invalid/v1",
    "model": "example-model",
    "apiKeyEnv": "IIBOT_LLM_API_KEY",
    "connectTimeoutSeconds": 10,
    "readTimeoutSeconds": 120,
    "echoReasoningContent": false
  },
  "dispatcher": {
    "maxConcurrentSessions": 64,
    "maxPendingPerUser": 16,
    "dedupeCapacity": 10000
  },
  "outbox": {
    "sendTimeoutSeconds": 15
  },
  "scheduler": {
    "autoFreezeIntervalSeconds": 30
  },
  "control": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8765,
    "path": "/mcp/control",
    "bearerTokenEnv": "IIBOT_CONTROL_TOKEN",
    "maxRequestBytes": 16777216
  },
  "llmRoutes": {
    "adjudicator": {
      "baseUrl": "https://api.example.invalid/v1",
      "model": "example-strong-model",
      "apiKeyEnv": "IIBOT_LLM_API_KEY",
      "connectTimeoutSeconds": 10,
      "readTimeoutSeconds": 180,
      "echoReasoningContent": true
    },
    "gmAide": {
      "baseUrl": "https://api.example.invalid/v1",
      "model": "example-gm-aide-model",
      "apiKeyEnv": "IIBOT_LLM_API_KEY",
      "connectTimeoutSeconds": 10,
      "readTimeoutSeconds": 180,
      "echoReasoningContent": true
    }
  },
  "agentRoutes": {
    "secretary": "default",
    "adjudicator": "adjudicator",
    "gmAide": "gmAide"
  }
}
