{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosire.local/iibot/bot-config.schema.json",
  "title": "iiBotMosire bot config v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataDir",
    "accounts",
    "control",
    "inbox"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "dataDir": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*",
      "description": "消息板、SQLite 和媒体根目录；相对路径以合并后配置目录为基准。"
    },
    "accounts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/account"
      },
      "description": "alias -> account 映射；P3 runtime 只启动第一个 enabled account。"
    },
    "control": {
      "$ref": "#/$defs/control"
    },
    "inbox": {
      "$ref": "#/$defs/inbox"
    },
    "messageBoard": {
      "$ref": "#/$defs/messageBoard"
    },
    "logging": {
      "$ref": "#/$defs/logging"
    },
    "video": {
      "$ref": "#/$defs/video"
    }
  },
  "$defs": {
    "envName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "只允许环境变量名，不允许保存 raw secret。"
    },
    "level": {
      "type": "string",
      "enum": [
        "TRACE",
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR",
        "OFF"
      ]
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "adapter",
        "accountId"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "adapter": {
          "enum": [
            "onebot11",
            "bilibili"
          ]
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "description": "稳定业务 accountId，也是消息板分区键；所有账号必须唯一。"
        },
        "oneBot": {
          "$ref": "#/$defs/oneBot"
        },
        "bilibili": {
          "$ref": "#/$defs/bilibili"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "onebot11"
              }
            },
            "required": [
              "adapter"
            ]
          },
          "then": {
            "required": [
              "oneBot"
            ],
            "not": {
              "required": [
                "bilibili"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "bilibili"
              }
            },
            "required": [
              "adapter"
            ]
          },
          "then": {
            "required": [
              "bilibili"
            ],
            "not": {
              "required": [
                "oneBot"
              ]
            }
          }
        }
      ]
    },
    "oneBot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventWebSocketUri",
        "httpBaseUri"
      ],
      "properties": {
        "eventWebSocketUri": {
          "type": "string",
          "format": "uri",
          "pattern": "^wss?://",
          "description": "OneBot 11 事件 WebSocket URI，必须带 host。"
        },
        "httpBaseUri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "OneBot 11 HTTP Action 根 URI，必须带 host。"
        },
        "accessTokenEnv": {
          "type": "string",
          "pattern": "^(|([A-Za-z_][A-Za-z0-9_]*))$",
          "description": "可选；oneBot access token 的环境变量名，不保存值。"
        },
        "privateTempGroupId": {
          "type": "string"
        },
        "suppressSelfMessages": {
          "type": "boolean",
          "default": true
        },
        "requestTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 10
        },
        "maxTextLength": {
          "type": "integer",
          "minimum": 1,
          "default": 2000
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bearerTokenEnv"
      ],
      "properties": {
        "host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "只允许回环地址。"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 8765
        },
        "path": {
          "type": "string",
          "pattern": "^/[^?#\\s]*$",
          "default": "/mcp/bot"
        },
        "bearerTokenEnv": {
          "$ref": "#/$defs/envName"
        }
      }
    },
    "inbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataDir": {
          "type": "string",
          "minLength": 1
        },
        "inboxId": {
          "type": "string",
          "minLength": 1,
          "default": "iibot-bot"
        },
        "bindingLabel": {
          "type": "string",
          "minLength": 1,
          "default": "dsh-bot"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "qq"
          ]
        },
        "bindingTtlHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8760,
          "default": 24
        },
        "apiHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "只允许回环地址。"
        },
        "apiPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0
        },
        "mcpHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "只允许回环地址。"
        },
        "mcpPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0
        },
        "mcpPath": {
          "type": "string",
          "pattern": "^/[^?#\\s]*$",
          "default": "/mcp"
        },
        "heartbeatMillis": {
          "type": "integer",
          "minimum": 1,
          "default": 15000
        },
        "claimSweepIntervalMillis": {
          "type": "integer",
          "minimum": 1,
          "default": 5000
        }
      }
    },
    "messageBoard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summaryDebounceMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000,
          "default": 2000,
          "description": "所有入站消息共用的 digest 合并窗口；不是按 @/权重分流的快慢通道"
        },
        "maxPreviewMessages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 20
        },
        "inlineMaxChars": {
          "type": "integer",
          "minimum": 0,
          "default": 512,
          "description": "digest 完整短文本内联目标长度；0 关闭。实际仍受 Inbox summary 512 字符存储边界约束"
        },
        "outbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sendTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600,
              "default": 15
            },
            "minSendIntervalMillis": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600000,
              "default": 150
            }
          }
        },
        "weighting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultPrivateSourceWeight": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000,
              "default": 300
            },
            "defaultGroupSourceWeight": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000,
              "default": 0
            },
            "defaultNotifyThreshold": {
              "type": "integer",
              "minimum": -1000,
              "maximum": 1000,
              "default": 100
            },
            "signalWeights": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "DM",
                  "MENTION",
                  "REPLY_TO_BOT",
                  "NAME",
                  "COMMAND"
                ]
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": -1000,
                "maximum": 1000
              }
            },
            "keywordWeights": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": -1000,
                "maximum": 1000
              }
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "commandPrefixes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "quietMillis": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000,
              "default": 180000,
              "description": "保留字段；当前全唤醒下不参与 wake gate/调度，合并窗口由 messageBoard.summaryDebounceMillis 决定"
            },
            "cooldownMillis": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000,
              "default": 60000,
              "description": "保留字段；当前全唤醒下不参与 wake gate/调度"
            }
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "default": "./logs"
        },
        "console": {
          "type": "boolean",
          "default": true
        },
        "file": {
          "type": "boolean",
          "default": true
        },
        "rootLevel": {
          "$ref": "#/$defs/level"
        },
        "opsLevel": {
          "$ref": "#/$defs/level"
        },
        "levels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(io\\.mosire\\.iibot\\.(connect|bot|app|inbox)(\\..+)?|iibot\\.ops)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/level"
          },
          "description": "已支持 connect/bot/app/inbox 包及其子包；未知包名由 loader fail-closed。"
        },
        "maxFileSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\s?(B|KB|MB|GB)$",
          "default": "20MB"
        },
        "maxHistory": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 30
        }
      }
    },
    "bilibili": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialFileEnv"
      ],
      "properties": {
        "credentialFileEnv": {
          "$ref": "#/$defs/envName"
        },
        "pollIntervalSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600,
          "default": 60
        },
        "receivePrivateMessages": {
          "type": "boolean",
          "default": true
        },
        "receiveCommentReplies": {
          "type": "boolean",
          "default": true
        },
        "writeEnabled": {
          "type": "boolean",
          "default": false
        },
        "maxWritesPerDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 3
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultQuality": {
          "type": "string",
          "enum": [
            "auto",
            "360p",
            "480p",
            "720p",
            "1080p",
            "best"
          ],
          "default": "auto"
        },
        "maxHeight": {
          "type": "integer",
          "minimum": 144,
          "maximum": 1080,
          "default": 720
        },
        "defaultFrameCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9,
          "default": 6
        },
        "maxFrameCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9,
          "default": 9
        },
        "comments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultLimit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "maxLimit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            },
            "allowFullScan": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "mode": {
              "type": "string",
              "enum": [
                "embedded",
                "remote-cdp"
              ],
              "default": "embedded"
            },
            "executablePath": {
              "type": "string",
              "default": ""
            },
            "cdpEndpoint": {
              "type": "string",
              "default": ""
            },
            "headless": {
              "type": "boolean",
              "default": true
            },
            "maxConcurrentSessions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "default": 2
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 5,
              "maximum": 300,
              "default": 60
            },
            "profileRoot": {
              "type": "string",
              "default": ""
            },
            "viewportWidth": {
              "type": "integer",
              "minimum": 320,
              "maximum": 3840,
              "default": 1280
            },
            "viewportHeight": {
              "type": "integer",
              "minimum": 240,
              "maximum": 2160,
              "default": 720
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "remote-cdp"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "cdpEndpoint"
                ],
                "properties": {
                  "cdpEndpoint": {
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
