#!/command/with-contenv sh
# 首启播种：只在目标文件/目录不存在时落盘，绝不覆盖用户改过的配置。
# 顺序：s6 cont-init.d 在 user 服务之前跑（宿主本身也用它 seed .env / config.yaml / SOUL.md）。
set -e

DATA="${IIBOT_DATA_DIR:-/opt/iibot/data}"
HOME_DIR="${HERMES_HOME:-/opt/data}"
DEFAULTS=/opt/hermes-defaults/deploy

mkdir -p "$DATA" "$DATA/logs" "$DATA/inbox" "$DATA/media"

if [ ! -f "$DATA/bot.json" ]; then
    cp "$DEFAULTS/iibot-bot.json" "$DATA/bot.json"
    echo "[seed] iibot 配置 -> $DATA/bot.json（改完要重启容器才生效）"
fi

mkdir -p "$HOME_DIR"
if [ ! -f "$HOME_DIR/config.yaml" ]; then
    # 模型三件套从环境渲染进来，镜像不绑定任何厂商：
    #   LLM_PROVIDER  （默认 custom:llm；用宿主原生 provider 就填它的 id，如 deepseek）
    #   LLM_BASE_URL  OpenAI 兼容端点，如 https://api.deepseek.com/v1
    #   LLM_MODEL     模型名
    # 密钥不落配置：配置里只写 key_env: LLM_API_KEY，值由 .env 进进程环境。
    # 注意只替换 @@LLM_*@@ 占位，配置里的 ${MCP_...} 是宿主运行期插值，必须原样保留。
    provider="${LLM_PROVIDER:-custom:llm}"
    base_url="${LLM_BASE_URL:-}"
    model="${LLM_MODEL:-}"
    if [ -z "$base_url" ] || [ -z "$model" ]; then
        echo "[seed] 警告：LLM_BASE_URL / LLM_MODEL 没设，先写空值；聊天前请在 .env 里补上并删掉卷里的 config.yaml 重新播种" >&2
    fi
    esc() { printf '%s' "$1" | sed -e 's/[&|]/\\&/g'; }
    sed -e "s|@@LLM_PROVIDER@@|$(esc "$provider")|g" \
        -e "s|@@LLM_BASE_URL@@|$(esc "$base_url")|g" \
        -e "s|@@LLM_MODEL@@|$(esc "$model")|g" \
        "$DEFAULTS/hermes-config.yaml.tmpl" > "$HOME_DIR/config.yaml"
    echo "[seed] hermes 配置 -> $HOME_DIR/config.yaml（provider=$provider model=${model:-空}）"
fi

mkdir -p "$HOME_DIR/plugins"
for id in persona-mode inbox-wake; do
    if [ ! -d "$HOME_DIR/plugins/$id" ]; then
        cp -a "/opt/hermes-defaults/plugins/$id" "$HOME_DIR/plugins/$id"
        echo "[seed] 插件 -> $HOME_DIR/plugins/$id"
    fi
done

if [ ! -f /opt/iibot/PERSONA.md ]; then
    cp "$DEFAULTS/PERSONA.md.example" /opt/iibot/PERSONA.md
    echo "[seed] 人设占位 -> /opt/iibot/PERSONA.md（换成你的，或把它挂进来）"
fi
