# 复制成 .env（compose 自动读取）。绝不提交。

# --- 模型：provider / base_url / key / model 全可配，镜像不绑定任何厂商 ---
# 用宿主原生 provider 时：LLM_PROVIDER=deepseek（或 openai / anthropic …），LLM_BASE_URL 可留空
LLM_PROVIDER=custom:llm
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- iiBot 业务工具面（8765）的 Bearer ---
# 裸机来源：grep '^IIBOT_CONTROL_TOKEN=' ~/.config/iibot/control.env | cut -d= -f2-
IIBOT_CONTROL_TOKEN=

# 其余留空由 cmd.sh 自动推导：
#   MCP_IIBOT_API_KEY        = IIBOT_CONTROL_TOKEN
#   MCP_INBOX_MOSIRE_API_KEY = <data>/inbox/program-mcp.token（iiBot 每次启动重签）

# 其他可选
# JAVA_OPTS=-Xms512m -Xmx2g
# INBOX_WAIT_SECONDS=60
