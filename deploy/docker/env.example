# 复制成 .env（compose 自动读取）。绝不提交。
NEWAPI_API_KEY=

# 8765 业务工具面（qq_*）的 Bearer：iiBot 读这个环境变量
#   裸机来源：grep '^IIBOT_CONTROL_TOKEN=' ~/.config/iibot/control.env | cut -d= -f2-
IIBOT_CONTROL_TOKEN=

# 可选覆盖：留空则容器启动后自动取值
#   46501 Inbox MCP（inbox_*）的 Bearer：iiBot 每次启动重签，只能运行时读
#   MCP_INBOX_MOSIRE_API_KEY=(留空 -> 读 /opt/iibot/data/inbox/program-mcp.token)
#   8765 的同一个值也可以单独给（留空 -> 复用 IIBOT_CONTROL_TOKEN）
# MCP_IIBOT_API_KEY=

# 其他可选
# JAVA_OPTS=-Xms512m -Xmx2g
# INBOX_WAIT_SECONDS=60
